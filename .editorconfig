root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,cpp,rc}]
max_line_length = 100

[*.{xml,vcxproj,props,targets,manifest,yml,yaml,json,vsconfig}]
indent_size = 2

[*.sln]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
