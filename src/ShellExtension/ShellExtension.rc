#include <windows.h>

#include "resource.h"

#include "../Domain/Version.h"

#pragma code_page(65001)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Command icons from Lucide (ISC license, see THIRD_PARTY_NOTICES.md), generated by
// scripts\build-icons.ps1 from packaging\icon\menu\*.svg.
IDI_GROUP_LIGHT     ICON "icons\\group-light.ico"
IDI_GROUP_DARK      ICON "icons\\group-dark.ico"
IDI_RENAME_LIGHT    ICON "icons\\rename-light.ico"
IDI_RENAME_DARK     ICON "icons\\rename-dark.ico"
IDI_DUPLICATE_LIGHT ICON "icons\\duplicate-light.ico"
IDI_DUPLICATE_DARK  ICON "icons\\duplicate-dark.ico"

// Shown in file properties and by tools that list loaded modules.
#ifdef ET_EMBED_VERSION_INFO
VS_VERSION_INFO VERSIONINFO
FILEVERSION ET_VERSION_MAJOR, ET_VERSION_MINOR, ET_VERSION_PATCH, 0
PRODUCTVERSION ET_VERSION_MAJOR, ET_VERSION_MINOR, ET_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Explorer Mate shell commands"
            VALUE "FileVersion", ET_VERSION_STRING
            VALUE "ProductName", "Explorer Mate"
            VALUE "ProductVersion", ET_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif
