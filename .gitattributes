# Normalise line endings in the repository; check out text with the platform default.
* text=auto

# Files that Windows tools expect with CRLF regardless of the checkout platform.
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.ps1      text eol=crlf
*.rc       text eol=crlf
*.def      text eol=crlf
*.manifest text eol=crlf

*.png  binary
*.ico  binary
*.msix binary
